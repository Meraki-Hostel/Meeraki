# Copy to .env (gitignored). EXPO_PUBLIC_* values are compiled into the app:
# never put a secret in one.

# The API, including /api/v1. On a phone, "localhost" is the phone itself:
# use your computer's LAN IP for local development.
EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000/api/v1

# The web app, for "Forgot password?" and screens that stay on the web.
EXPO_PUBLIC_WEB_URL=http://192.168.1.10:5173

# Store pages, shown on the "Update required" screen. Empty until published.
EXPO_PUBLIC_APP_STORE_URL=
EXPO_PUBLIC_PLAY_STORE_URL=

# Build-time only (app.config.ts), not compiled into the JS bundle.
# EAS project id from `eas init` — push notifications need it.
EAS_PROJECT_ID=
# Firebase (FCM) config for Android push: do NOT put it here. Upload google-services.json to EAS
# as a file variable named GOOGLE_SERVICES_JSON (see docs/11-play-store-release.md).

# Overrides while the app identity is undecided (defaults: StayPookie / com.staypookie.app).
APP_NAME=
APP_BUNDLE_ID=
