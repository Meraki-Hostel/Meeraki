# Same production database as backend/ — this app only reads/writes Organization
# and User rows (and only via its own trimmed prisma/schema.prisma). NEVER run
# `prisma migrate` from this app; only `prisma generate`. Migrations are owned by backend/.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/staypookie?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/staypookie?sslmode=require"

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=replace_me
# Local dev default; set to the deployed admin app's own URL in production.
NEXTAUTH_URL=http://localhost:3000

# From Google Cloud Console → APIs & Services → Credentials → OAuth client ID.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of the only Google accounts allowed to sign in.
ADMIN_EMAIL_ALLOWLIST=su-24092@sitare.org,su-24032@sitare.org,su-24084@sitare.org,su-24110@sitare.org
