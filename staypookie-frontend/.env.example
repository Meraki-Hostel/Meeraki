# Required. The real app talks only to this API; the build fails without it.
# (The mock-data demo is the separate /prototype app.)
VITE_API_BASE_URL=http://localhost:4000/api/v1

# Optional. Shown on the public privacy policy (/privacy) as the address for data requests.
# Set it before publishing the mobile app; app stores require a working contact.
# VITE_SUPPORT_EMAIL=
