{
  "name": "staypookie-api",
  "version": "0.1.0",
  "description": "StayPookie hostel-management REST API (Node + Express + Prisma + Neon). Matches the StayPookie frontend service contract. One API for web and mobile.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "build": "prisma generate && prisma migrate deploy",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "node prisma/seed.js",
    "db:seed:prod": "node prisma/seed-prod.js",
    "job": "node src/jobs/cli.js",
    "test": "node --test --test-reporter=spec --test-concurrency=1 \"test/**/*.test.js\"",
    "test:strict": "STRICT_DEFECTS=1 node --test --test-reporter=spec --test-concurrency=1 \"test/**/*.test.js\"",
    "test:db:up": "sh scripts/test-db.sh up",
    "test:db:down": "sh scripts/test-db.sh down"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@prisma/client": "^5.22.0",
    "@prisma/internals": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.2",
    "uuid": "^11.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "supertest": "^7.3.1"
  },
  "engines": {
    "node": ">=20"
  }
}
