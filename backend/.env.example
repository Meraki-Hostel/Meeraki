NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173

# Neon: pooled URL for the app, direct URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/meraki?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/meraki?sslmode=require"

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_me_access
JWT_REFRESH_SECRET=replace_me_refresh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Demo shared password (matches the frontend DEMO_PASSWORD so demo logins work).
DEMO_PASSWORD=meraki@123

# Payments: 'simulated' mirrors the frontend demo gateway. Switch to 'razorpay'
# and fill keys to take real online payments (see README → Payments).
PAYMENT_MODE=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
