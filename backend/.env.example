# ── REQUIRED (server throws at boot if missing) ──────────────────────────────
# Neon: pooled URL for the app, direct (unpooled) URL for migrations.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/staypookie?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/staypookie?sslmode=require"

# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production: each must be >=32 chars, not a placeholder, and different from the other.
JWT_ACCESS_SECRET=replace_me_access
JWT_REFRESH_SECRET=replace_me_refresh

# ── REQUIRED IN PRODUCTION (empty/default is only accepted in development) ──
# Comma-separated list of allowed frontend origin(s). Must not be empty or "*".
CORS_ORIGINS=http://localhost:5173

# ── Core ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Business dates (today, billing month, receipt year) use this IANA time zone.
APP_TIMEZONE=Asia/Kolkata
# The web app's address: links in invitation and password-reset emails point here.
APP_URL=http://localhost:5173
# This API's public address (used for local-storage upload links).
PUBLIC_API_URL=http://localhost:4000

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Only read by `npm run db:seed` (local demo data). The API itself has no demo
# login, and the demo seed refuses to run when NODE_ENV=production.
DEMO_PASSWORD=meraki@123

# ── Payments ─────────────────────────────────────────────────────────────────
#   disabled  (default) students cannot pay online; the app says so; staff record payments.
#   simulated LOCAL DEVELOPMENT ONLY: records a payment labelled "simulated", no money moves.
#             The server refuses to start in production with it.
#   razorpay  real gateway; needs the three keys below (REQUIRED when PAYMENT_MODE=razorpay).
#             A payment counts only after the server confirms it with Razorpay:
#             /payments/verify (right after Checkout) and the signed webhook
#             POST /api/v1/payments/webhook (configure it in the Razorpay dashboard with
#             events payment.captured, payment.failed, refund.processed, refund.failed).
# rzp_live_ keys are refused unless PAYMENTS_LIVE_ENABLED=true (verify in test mode first).
PAYMENT_MODE=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENTS_LIVE_ENABLED=false

# ── Email (invitations, password reset, emergency alerts) ────────────────────
#   console  (development default) prints emails to the server log; refused in production
#   resend   sends through https://resend.com (needs RESEND_API_KEY, REQUIRED when MAIL_MODE=resend,
#            and a verified sender domain)
#   disabled (production default) features that need email say so; invitation links are
#            still shown to the admin who sent them, to share another way
MAIL_MODE=console
MAIL_FROM="StayPookie <no-reply@your-domain.example>"
RESEND_API_KEY=

# ── File storage (student documents, complaint photos) ───────────────────────
#   local    (development default) files in STORAGE_LOCAL_DIR; refused in production
#   r2       Cloudflare R2: private bucket, presigned upload/download URLs (see README);
#            R2_* below are all REQUIRED when STORAGE_MODE=r2
#   disabled (production default) uploads say "not set up"
STORAGE_MODE=local
STORAGE_LOCAL_DIR=uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
UPLOAD_MAX_MB=5
SIGNED_URL_TTL_SECONDS=300

# ── Push notifications to the mobile app ─────────────────────────────────────
#   console  (development default) pushes are logged, not sent; refused in production
#   expo     sent through the Expo Push Service (FCM + APNs). EXPO_ACCESS_TOKEN is only
#            needed when "enhanced push security" is on for the Expo project
#   disabled (production default) phones cannot register; the app hides push
PUSH_MODE=console
EXPO_ACCESS_TOKEN=

# ── Mobile app versions (GET /app/config) ────────────────────────────────────
# Below MOBILE_MIN_VERSION the app asks the user to update before continuing.
# Raise it only for a breaking API change. Format 1.2.3.
MOBILE_MIN_VERSION=1.0.0
MOBILE_LATEST_VERSION=1.0.0

# ── Scheduled jobs (rent on the 1st, late fees, reminders, snapshots, cleanup) ─
# true = run in this process (one always-on server). Set false when the host sleeps
# idle instances and run `npm run job <name>` from an external cron instead.
JOBS_ENABLED=true

# ── First owner for a real deployment ─────────────────────────────────────────
# Only read by `npm run db:seed:prod` (refuses if any user already exists); remove after seeding.
# ORG_NAME=
# OWNER_NAME=
# OWNER_EMAIL=
# OWNER_PHONE=
# OWNER_PASSWORD=   # 12+ characters
